<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title>📋 Submissions</title>
  <style>
    body { font-family: sans-serif; padding: 2rem; }
    h1 { color: green; }
    ul { list-style: none; padding: 0; }
    li { margin-bottom: 10px; }
  </style>
</head>
<body>
  <h1>📋 Submissions</h1>
  <ul>
    <% submissions.forEach(sub => { %>
      <li><strong><%= sub.name %></strong> - <%= sub.email %></li>
    <% }) %>
  </ul>
</body>
</html>

